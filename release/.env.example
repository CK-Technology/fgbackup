# Copy to release/.env and fill in. Never commit the real .env.

# --- FortiCloud IAM API user (from the IAM portal credentials ZIP) ---
FGB_FORTICLOUD_API_ID=
FGB_FORTICLOUD_API_PASSWORD=
# Region of your FortiCloud account API host: global | us | eu | jp
FGB_FORTICLOUD_REGION=global

# --- restic repository on Wasabi S3 ---
# Use the region endpoint of the bucket you created.
RESTIC_REPOSITORY=s3:https://s3.us-east-1.wasabisys.com/your-bucket-name
# Strong passphrase that encrypts the repo. LOSING THIS = LOSING THE BACKUPS.
RESTIC_PASSWORD=
# Wasabi access keys (S3-compatible).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- restic retention (applied by `fgbackup forget`) ---
FGB_KEEP_DAILY=14
FGB_KEEP_WEEKLY=8
FGB_KEEP_MONTHLY=12

# --- misc ---
FGB_STAGING_DIR=/staging
TZ=UTC
